// glslangValidator -V --target-env vulkan1.3 -S mesh -o vkSimpleMesh.mesh.spv vkSimpleMesh.mesh
#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 128) in;

// Meshlet structure
struct meshlet {
    uint vertexOffset;
    uint triangleOffset;
    uint vertexCount;
    uint triangleCount;
};

struct vertex {
    vec3 position;       float _pad0;
    vec2 textureCoords;  vec2  _pad1;
    vec3 normal;         float _pad2;
    vec3 tangent;        float _pad3;
};

// input.
layout(buffer_reference, std430) readonly buffer vertexBuffer{ 
	vertex vertices[];
};

layout(buffer_reference, std430) readonly buffer indexBuffer{ 
	uint indices[];
};

layout(buffer_reference, std430) readonly buffer meshletBuffer{ 
	meshlet meshlets[];
};

layout(buffer_reference, std430) readonly buffer triangleBuffer{ 
	uint triangles[];
};

// Push constants
layout(push_constant) uniform constants
{
	mat4 viewProjection;
	vertexBuffer vb;
	indexBuffer ib;
    triangleBuffer tb;
    meshletBuffer mb;
} pushConstants;

// Output.
layout(location = 0) out vec3 vColor[];
layout(location = 1) out vec4 vPosition[];

layout(max_vertices = 64, max_primitives = 128) out;
layout(triangles) out;

void main() {
    uint gtid = gl_LocalInvocationID.x;
    uint gid  = gl_WorkGroupID.x;

    meshlet m = pushConstants.mb.meshlets[gid];
    SetMeshOutputsEXT(m.vertexCount, m.triangleCount);

    // Output triangle indices
    if (gtid < m.triangleCount) {
        uint packed = pushConstants.tb.triangles[m.triangleOffset + gtid];
        uint vIdx0  = (packed >> 0) & 0xFF;
        uint vIdx1  = (packed >> 8) & 0xFF;
        uint vIdx2  = (packed >> 16) & 0xFF;
        gl_PrimitiveTriangleIndicesEXT[gtid] = uvec3(vIdx0, vIdx1, vIdx2);
    }

    // Output vertex data
    if (gtid < m.vertexCount) {
        uint vertexIndex = m.vertexOffset + gtid;        
        vertexIndex = pushConstants.ib.indices[vertexIndex];

        vec3 color = vec3(
            float(gid & 1),
            float(gid & 3) / 4.0,
            float(gid & 7) / 8.0
        );

        vColor[gtid] = color;
        
        vPosition[gtid] = pushConstants.viewProjection * vec4(pushConstants.vb.vertices[vertexIndex].position, 1.0);;
    }
}
