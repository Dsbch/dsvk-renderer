//dxc -T cs_6_9 -E main -spirv -Fo vkCompute.spv vkCompute.comp

RWTexture2D<min16float4> colorAttachment : register(u0, space0);

[numthreads(32, 32, 1)]
void main(uint3 DTid : SV_DispatchThreadID)
{
    // Write a white pixel into the target texel
    colorAttachment[DTid.xy] = min16float4(1.0f, 1.0f, 1.0f, 1.0f);
}
